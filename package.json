{
  "name": "yyc3-novamind",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3218",
    "build": "next build",
    "start": "next start -p 3218",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "deps:check": "pnpm dlx depcheck",
    "deps:outdated": "pnpm outdated",
    "deps:audit": "pnpm audit --prod",
    "openapi:generate": "next-openapi-gen generate",
    "openapi:check": "next-openapi-gen generate && git diff --exit-code public/docs/openapi.generated.yaml",
    "openapi:init": "next-openapi-gen init",
    "openapi:ui": "pnpm dlx @redocly/cli preview-docs public/docs/openapi.generated.yaml"
  },
