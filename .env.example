# YYC³ NovaMind 环境变量模板
# 复制为 .env.local 并填入真实值；.env* 已在 .gitignore 中，严禁提交真实密钥

# ── Sentry 错误监控（P0-③）──────────────────────────
# 缺省时 Sentry 完全禁用（零开销）；填入 DSN 后自动启用
# 前端（浏览器）错误上报
NEXT_PUBLIC_SENTRY_DSN=
# 服务端（RSC / Route Handlers）错误上报
SENTRY_DSN=
# 环境标识（缺省取 NODE_ENV）
NEXT_PUBLIC_SENTRY_ENV=
SENTRY_ENV=

# ── AI 服务（可选）─────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LOCAL_AI_URL=
LOCAL_AI_KEY=

# ── 数据库（Phase A 资产 2：DSN 驱动降级）────────────
# 缺省时持久化完全禁用（内存态运行）；填入后自动启用会话/用户/反馈持久化
DATABASE_URL=
# ── AI 成本护栏（Phase A 资产 1）─────────────────────
# 全局日 token 预算（缺省 2000000）
AI_DAILY_TOKEN_BUDGET=
# ── Auth.js v5（Phase A 资产 3）──────────────────────
# 会话加密密钥：openssl rand -base64 32
AUTH_SECRET=
# 管理员邮箱白名单（逗号分隔；命中 → admin 角色）
AUTH_ADMIN_EMAILS=
# OAuth Provider（可选：配置了才启用对应登录方式；不配走演示账户通道）
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
